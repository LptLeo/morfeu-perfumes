# ─────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env.local (não commitado) e preencha.
# Em produção (Netlify), cadastre as mesmas variáveis no dashboard:
# Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────────────────

# Firebase Web App — console.firebase.google.com
# ⚙️ Configurações do projeto → Geral → Seus apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# E-mails autorizados a entrar no painel (separados por vírgula).
# Camada de UX apenas — a autorização real vive nas firestore.rules (isAdmin).
# ⚠️ Espere estes e-mails também em firestore.rules → adminEmails().
VITE_ADMIN_EMAILS=marcosmorfeumachado@gmail.com

# Cloudinary (upload de fotos do painel) — dashboard.cloudinary.com
# ⚙️ Escopo Functions na Netlify; nunca use prefixo VITE_ (viraria público).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Credenciais usadas APENAS por scripts/migrate-to-cloudinary.mjs (local).
MIGRATION_EMAIL=
MIGRATION_PASSWORD=

# ⚠️ SEGREDOS DE SERVIDOR NUNCA USAM PREFIXO VITE_*
# Toda variável VITE_* vira texto público dentro do bundle JS entregue ao
# navegador. Segredos são cadastrados no dashboard da Netlify com escopo
# Functions e lidos apenas pelas netlify/functions via process.env.
