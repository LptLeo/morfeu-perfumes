# ─────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env.local (não commitado) e preencha.
# Em produção (Netlify), cadastre as mesmas variáveis no dashboard:
# Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────────────────

# Firebase Web App — console.firebase.google.com
# ⚙️ Configurações do projeto → Geral → Seus apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# E-mails autorizados a entrar no painel via Google (separados por vírgula).
# Camada de UX apenas — a autorização real vive nas firestore.rules (isAdmin).
# ⚠️ Espelhe este e-mail também em firestore.rules → adminEmails().
VITE_ADMIN_EMAILS=marcosmorfeumachado@gmail.com

# ⚠️ SEGREDOS DE SERVIDOR NUNCA USAM PREFIXO VITE_*
# Toda variável VITE_* vira texto público dentro do bundle JS entregue ao
# navegador. Segredos (ex.: IMGBB_KEY, no ciclo do CRUD) são cadastrados no
# dashboard da Netlify e lidos apenas pelas netlify/functions via process.env.
