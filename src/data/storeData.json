  "faq": {
    "eyebrow": "Dúvidas frequentes",
    "title": "Antes de comprar, tire suas dúvidas",
    "items": [
      {
        "id": "faq-1",
        "question": "O que é um decant?",
        "answer": "Um decant é uma pequena quantidade de um perfume original, transferida para um frasco menor — ideal para experimentar a fragrância antes de decidir pelo frasco inteiro."
      },
      {
        "id": "faq-2",
        "question": "Os perfumes são originais?",
        "answer": "Sim. Trabalhamos apenas com fragrâncias selecionadas e de procedência confiável, transferidas com cuidado para os frascos de decant. Qualquer dúvida sobre a origem, é só falar com a gente pelo WhatsApp."
      },
      {
        "id": "faq-3",
        "question": "Quais tamanhos estão disponíveis?",
        "answer": "Trabalhamos com decants de 3ml, 5ml e 10ml — tamanhos ideais para experimentar na pele e para levar na bolsa ou na viagem."
      },
      {
        "id": "faq-4",
        "question": "Como faço meu pedido?",
        "answer": "Escolha o perfume no catálogo acima e clique no botão do produto — você será direcionado direto para o WhatsApp com uma mensagem pronta para finalizar o pedido com a nossa equipe."
      },
      {
        "id": "faq-5",
        "question": "Vocês enviam para minha cidade?",
        "answer": "Sim! Ao finalizar o pedido pelo WhatsApp, combinamos a melhor forma de envio ou retirada para você."
      },
      {
        "id": "faq-6",
        "question": "Posso comprar mais de um decant?",
        "answer": "Sim — é só chamar no WhatsApp e montar seu pedido com quantos decants quiser."
      }
    ]
  },
